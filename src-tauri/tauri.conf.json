{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TokenHusk",
  "version": "0.1.0",
  "identifier": "com.tokenhusk.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "title": "TokenHusk", "width": 960, "height": 640, "resizable": true }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": []
  }
}
